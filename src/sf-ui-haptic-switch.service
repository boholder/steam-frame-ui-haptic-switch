[Unit]
Description=Steam Frame UI Haptic Switch daemon
Documentation=file://INSTALLATION_PATH/README.md
After=steamvr.service
PartOf=steamvr.service
StartLimitIntervalSec=60
StartLimitBurst=3

[Service]
Type=simple
Environment=PYTHONUNBUFFERED=1
ExecStart=/usr/bin/python3 INSTALLATION_PATH/src/sf_ui_haptic_switch_daemon.py
Restart=always
RestartSec=5
# Lower CPU scheduling priority than the compositor.
Nice=10

[Install]
WantedBy=steamvr.service
