[Unit]
Description=Steam Frame "Controller UI Haptic" switch
Documentation=file:///home/steamos/sf-haptic-switch/README.md
After=multi-user.target graphical.target

[Service]
Type=simple
Environment=PYTHONUNBUFFERED=1
ExecStart=/usr/bin/python3 /home/steamos/sf-haptic-switch/sf_haptic_switch_daemon.py --js /home/steamos/sf-haptic-switch/sf_haptic_switch.js
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
